# Copy to .env and fill in. .env is gitignored.

# --- MongoDB Atlas ---
# Any Atlas M10+ cluster on MongoDB 8.1+ (CONTINUOUS) supports every feature this demo uses.
MONGODB_URI=mongodb+srv://USER:PASS@your-cluster.xxxxx.mongodb.net/?retryWrites=true
MONGODB_DB=nova_rca

# --- Atlas Admin API (search index management; https://cloud.mongodb.com/v2#/org/.../access) ---
ATLAS_PUB_KEY=
ATLAS_PRIV_KEY=
ATLAS_GROUP_ID=
ATLAS_CLUSTER=

# --- Grove LLM (OpenAI-compatible gateway; auth via custom api-key header) ---
GROVE_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1
GROVE_API_KEY=
GROVE_MODEL=gpt-4o-mini
LLM_FAST_MODEL=gpt-4o-mini
LLM_REASONING_MODEL=gpt-4o-mini
# vision-capable model for screenshot triage in the Investigate chat
LLM_VISION_MODEL=gpt-4o-mini
# json_schema | json_mode | prompt  (P0 spike picks the best supported rung)
GROVE_STRUCTURED_MODE=json_schema
GROVE_MAX_RETRIES=3
GROVE_TIMEOUT_SECONDS=60
# set to 0 to omit temperature entirely (some Grove models reject custom values)
GROVE_SEND_TEMPERATURE=0

# --- Agent tuning ---
DEBOUNCE_WINDOW_SECONDS=4
COLLECT_WINDOW_SECONDS=120
RECALL_MIN_VECTOR_SCORE=0.72
AGENT_PORT=8000
UI_PORT=5173
REPLAY_MODE=0
# how far back the Investigate chat searches audit logs (minutes)
CHAT_LOOKBACK_MINUTES=30
